/// <summary>
///  What the model layer (Kitto.Metadata.Models) needs to know about the
///  application it runs in, without depending on the application
///  configuration: whether the alternate-language labels are in use, the
///  name of the default database, and the macro expansion engine for default
///  values. Each one is a callback with a plain default, so the models can be
///  loaded, edited and generated by a program that has no TKConfig at all (a
///  console tool, a model generator, another application), while a KittoX
///  application plugs its configuration in once at startup (see Kitto.Config).
/// </summary>
unit Kitto.Metadata.Context;

interface

uses
  System.SysUtils,
  EF.Macros;

type
  TKMetadataContext = class
  strict private
    class var FOnGetUseAltLanguage: TFunc<Boolean>;
    class var FOnGetDefaultDatabaseName: TFunc<string>;
    class var FOnGetMacroExpansionEngine: TFunc<TEFMacroExpansionEngine>;
    class var FOnGetCurrentUserName: TFunc<string>;
    class var FDefaultUseAltLanguage: Boolean;
    class var FDefaultDatabaseNameValue: string;
  public
    /// <summary>True when the "2" variants of the labels (DisplayLabel2,
    /// Hint2...) are to be used. The callback wins; without one the plain
    /// value applies (False unless set).</summary>
    class function UseAltLanguage: Boolean; static;
    /// <summary>Name of the database a model without a DatabaseRouter maps to.
    /// The callback wins; without one the plain value applies ('' unless set).</summary>
    class function DefaultDatabaseName: string; static;
    /// <summary>Engine that expands macros in string default values. The
    /// callback wins; without one the shared TEFMacroExpansionEngine.Instance
    /// is used, which already knows the standard expanders.</summary>
    class function MacroExpansionEngine: TEFMacroExpansionEngine; static;
    /// <summary>Name of the user the access checks of the metadata are made
    /// for. The callback wins; without one it is empty (no user: a tool).</summary>
    class function CurrentUserName: string; static;

    /// <summary>Detaches every callback: what a host sets at startup, it
    /// removes at shutdown, so nothing can call into a freed configuration.</summary>
    class procedure ResetCallbacks; static;

    class property OnGetUseAltLanguage: TFunc<Boolean> read FOnGetUseAltLanguage write FOnGetUseAltLanguage;
    class property OnGetDefaultDatabaseName: TFunc<string> read FOnGetDefaultDatabaseName write FOnGetDefaultDatabaseName;
    class property OnGetMacroExpansionEngine: TFunc<TEFMacroExpansionEngine> read FOnGetMacroExpansionEngine write FOnGetMacroExpansionEngine;
    class property OnGetCurrentUserName: TFunc<string> read FOnGetCurrentUserName write FOnGetCurrentUserName;
    /// <summary>Plain values, used when the corresponding callback is not set:
    /// the way a host without a configuration (a generator, a test) tells the
    /// models what they need.</summary>
    class property DefaultUseAltLanguage: Boolean read FDefaultUseAltLanguage write FDefaultUseAltLanguage;
    class property DefaultDatabaseNameValue: string read FDefaultDatabaseNameValue write FDefaultDatabaseNameValue;
  end;

implementation

{ TKMetadataContext }

class function TKMetadataContext.UseAltLanguage: Boolean;
begin
  if Assigned(FOnGetUseAltLanguage) then
    Result := FOnGetUseAltLanguage()
  else
    Result := FDefaultUseAltLanguage;
end;

class function TKMetadataContext.DefaultDatabaseName: string;
begin
  if Assigned(FOnGetDefaultDatabaseName) then
    Result := FOnGetDefaultDatabaseName()
  else
    Result := FDefaultDatabaseNameValue;
end;

class function TKMetadataContext.MacroExpansionEngine: TEFMacroExpansionEngine;
begin
  Result := nil;
  if Assigned(FOnGetMacroExpansionEngine) then
    Result := FOnGetMacroExpansionEngine();
  if not Assigned(Result) then
    Result := TEFMacroExpansionEngine.Instance;
end;

class function TKMetadataContext.CurrentUserName: string;
begin
  if Assigned(FOnGetCurrentUserName) then
    Result := FOnGetCurrentUserName()
  else
    Result := '';
end;

class procedure TKMetadataContext.ResetCallbacks;
begin
  FOnGetUseAltLanguage := nil;
  FOnGetDefaultDatabaseName := nil;
  FOnGetMacroExpansionEngine := nil;
  FOnGetCurrentUserName := nil;
end;

end.
