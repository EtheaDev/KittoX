<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{6F1B4C2A-7D93-4E58-9C41-2B8A5E7D0F36}</ProjectGuid>
        <MainSource>KittoXTests.dpr</MainSource>
        <ProjectVersion>20.5</ProjectVersion>
        <FrameworkType>None</FrameworkType>
        <Base>True</Base>
        <Config Condition="'$(Config)'==''">Debug</Config>
        <Platform Condition="'$(Platform)'==''">Win64</Platform>
        <TargetedPlatforms>3</TargetedPlatforms>
        <AppType>Console</AppType>
        <ProjectName Condition="'$(ProjectName)'==''">KittoXTests</ProjectName>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Base' or '$(Base)'!=''">
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win32' and '$(Base)'=='true') or '$(Base_Win32)'!=''">
        <Base_Win32>true</Base_Win32>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="('$(Platform)'=='Win64' and '$(Base)'=='true') or '$(Base_Win64)'!=''">
        <Base_Win64>true</Base_Win64>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Debug' or '$(Cfg_1)'!=''">
        <Cfg_1>true</Cfg_1>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Config)'=='Release' or '$(Cfg_2)'!=''">
        <Cfg_2>true</Cfg_2>
        <CfgParent>Base</CfgParent>
        <Base>true</Base>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Base)'!=''">
        <DCC_AssertionsAtRuntime>true</DCC_AssertionsAtRuntime>
        <DCC_DcuOutput>..\..\Lib\D13\$(Platform)\$(Config)</DCC_DcuOutput>
        <DCC_ExeOutput>..\..\Bin\$(Platform)\$(Config)</DCC_ExeOutput>
        <DCC_UnitSearchPath>..\..\Source;..\..\..\Source;..\..\..\Source\EF;..\..\..\Source\ThirdParty;..\..\..\Source\ThirdParty\MarkdownProcessor\source;..\..\..\Source\ThirdParty\delphi-jose-jwt\Source\Common;..\..\..\Source\ThirdParty\delphi-jose-jwt\Source\JOSE;$(DCC_UnitSearchPath)</DCC_UnitSearchPath>
        <DCC_Namespace>System;Xml;Data;Datasnap;Web;Soap;$(DCC_Namespace)</DCC_Namespace>
        <DCC_E>false</DCC_E>
        <DCC_N>false</DCC_N>
        <DCC_S>false</DCC_S>
        <DCC_F>false</DCC_F>
        <DCC_K>false</DCC_K>
        <SanitizedProjectName>KittoXTests</SanitizedProjectName>
        <VerInfo_Locale>1033</VerInfo_Locale>
        <VerInfo_Keys>CompanyName=Ethea S.r.l.;FileDescription=KittoX Test Suite;FileVersion=4.1.0.0;InternalName=KittoXTests;LegalCopyright=Copyright (c) Ethea S.r.l.;ProductName=KittoX;ProductVersion=4.1</VerInfo_Keys>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_1)'!=''">
        <DCC_Define>DEBUG;$(DCC_Define)</DCC_Define>
        <DCC_DebugDCUs>true</DCC_DebugDCUs>
        <DCC_DebugInfoInExe>true</DCC_DebugInfoInExe>
        <DCC_GenerateStackFrames>true</DCC_GenerateStackFrames>
        <DCC_Optimize>false</DCC_Optimize>
        <DCC_RemoteDebug>false</DCC_RemoteDebug>
        <!-- The suite runs with the guards ON: an out-of-range access must fail
             a test here rather than silently corrupt memory in production.
             Framework units no longer override these (see EF.Defines.inc). -->
        <DCC_RangeChecking>true</DCC_RangeChecking>
        <DCC_IntegerOverflowCheck>true</DCC_IntegerOverflowCheck>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Cfg_2)'!=''">
        <DCC_Define>RELEASE;$(DCC_Define)</DCC_Define>
        <DCC_DebugInfo>0</DCC_DebugInfo>
        <DCC_LocalDebugSymbols>false</DCC_LocalDebugSymbols>
        <DCC_SymbolReferenceInfo>0</DCC_SymbolReferenceInfo>
        <DCC_Optimize>true</DCC_Optimize>
    </PropertyGroup>
    <ItemGroup>
        <DelphiCompile Include="$(MainSource)">
            <MainSource>MainSource</MainSource>
        </DelphiCompile>
        <DCCReference Include="..\..\Source\Kitto.TestUtils.pas"/>
        <DCCReference Include="..\..\Source\EF.StrUtilsTests.pas"/>
        <DCCReference Include="..\..\Source\EF.MacrosTests.pas"/>
        <DCCReference Include="..\..\Source\EF.RegExTests.pas"/>
        <DCCReference Include="..\..\Source\EF.TreeTests.pas"/>
        <DCCReference Include="..\..\Source\EF.SQLJSONTests.pas"/>
        <DCCReference Include="..\..\Source\EF.YAMLTests.pas"/>
        <DCCReference Include="..\..\Source\EF.XMLTests.pas"/>
        <DCCReference Include="..\..\Source\EF.StreamsTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.MetadataCatalogTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.YamlNodeDeclarationTests.pas"/>
        <DCCReference Include="..\..\Source\EF.DBTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.TestDB.pas"/>
        <DCCReference Include="..\..\Source\EF.DBIntegrationTests.pas"/>
        <DCCReference Include="..\..\Source\EF.LoggerTests.pas"/>
        <DCCReference Include="..\..\Source\EF.SysTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.JWTTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.WebRoutesTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.AuthTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.SessionTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.DBUtilsTests.pas"/>
        <DCCReference Include="..\..\Source\Kitto.ChatHtmlTests.pas"/>
        <BuildConfiguration Include="Base">
            <Key>Base</Key>
        </BuildConfiguration>
        <BuildConfiguration Include="Debug">
            <Key>Cfg_1</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
        <BuildConfiguration Include="Release">
            <Key>Cfg_2</Key>
            <CfgParent>Base</CfgParent>
        </BuildConfiguration>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Delphi.Personality.12</Borland.Personality>
        <Borland.ProjectType>Application</Borland.ProjectType>
        <BorlandProject>
            <Delphi.Personality>
                <Source>
                    <Source Name="MainSource">KittoXTests.dpr</Source>
                </Source>
            </Delphi.Personality>
        </BorlandProject>
    </ProjectExtensions>
    <Import Project="$(BDS)\Bin\CodeGear.Delphi.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Delphi.Targets')"/>
</Project>
